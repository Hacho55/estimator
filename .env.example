# Aplicación
APP_NAME=Estimador CAG
APP_ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_PROMPTS=false

# Proxy LiteLLM (compatible con el SDK de OpenAI)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.doi.azure.datadope.co

# Modelo y llamada. El proveedor lo decide el nombre del modelo
# (openrouter/openai/... o openrouter/anthropic/...).
LLM_MODEL=openrouter/openai/gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RESPONSE_FORMAT=json_schema
LLM_PROMPT_CACHE=auto

# Contexto CAG
CONTEXT_FORMAT=markdown
CONTEXT_DETAIL_LEVEL=standard
CONTEXT_MAX_EXAMPLES=7
CONTEXT_MAX_AGE_YEARS=4
CONTEXT_MAX_TOKENS=6000

# Presupuesto de la ventana de contexto
MODEL_CONTEXT_WINDOW=128000
CONTEXT_SAFETY_MARGIN_TOKENS=5000
TRANSCRIPTION_MAX_CHARS=40000

# Conversación multi-turn (memoria del proceso, un solo worker)
CONVERSATION_MAX_TURNS=10
CONVERSATION_TTL_MINUTES=60
CONVERSATION_MAX_ACTIVE=1000
CONVERSATION_NEAR_LIMIT_RATIO=0.8

# Langfuse Cloud (opcional). Sin claves no se envían trazas.
# Crea un proyecto en https://cloud.langfuse.com y copia las claves del proyecto.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
