# Aplicación
APP_NAME=Estimador CAG
APP_ENV=development
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_PROMPTS=false

# Proxy LiteLLM (compatible con el SDK de OpenAI)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.doi.azure.datadope.co

# Modelo y llamada. El proveedor lo decide el nombre del modelo
# (openrouter/openai/... o openrouter/anthropic/...).
LLM_MODEL=openrouter/openai/gpt-4o-mini
# Sesión 3 · fallback: vacío no cambia de modelo.
# Ejemplo: openrouter/anthropic/claude-haiku-4.5
LLM_FALLBACK_MODEL=
# Sesión 3 · routing: off usa siempre LLM_MODEL. complexity baja un texto corto al reserva.
LLM_ROUTING=off
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RESPONSE_FORMAT=json_schema
LLM_PROMPT_CACHE=auto
# Carpeta de plantilla por defecto (v1 o v2). Se puede anular por petición en /api/v2.
LLM_PROMPT_VERSION=v1

# Guardrails: log registra sin bloquear; enforce rechaza inyecciones (422).
GUARDRAILS_MODE=log
PII_SCORE_THRESHOLD=0.5

# Caché semántica (Redis). log mide sin servir; on sirve aciertos; off la apaga.
REDIS_URL=
SEMANTIC_CACHE_MODE=log
SEMANTIC_CACHE_THRESHOLD=0.92
EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
EMBEDDING_DIMS=1536

# Contexto CAG
CONTEXT_FORMAT=markdown
CONTEXT_DETAIL_LEVEL=standard
CONTEXT_MAX_EXAMPLES=7
CONTEXT_MAX_AGE_YEARS=4
CONTEXT_MAX_TOKENS=6000

# Presupuesto de la ventana de contexto
MODEL_CONTEXT_WINDOW=128000
CONTEXT_SAFETY_MARGIN_TOKENS=5000
TRANSCRIPTION_MAX_CHARS=40000

# Conversación multi-turn (memoria del proceso, un solo worker)
CONVERSATION_MAX_TURNS=10
# Sesiones: ventana sin anclas, y tope de adjuntos PDF/Word.
SESSION_MAX_TURNS=6
ATTACHMENT_MAX_FILES=5
ATTACHMENT_MAX_BYTES=5000000
ATTACHMENT_MAX_EXPANDED_BYTES=50000000
# Texto de todos los adjuntos de un turno (lo que pase se trunca con aviso)
ATTACHMENT_MAX_CHARS=40000
# Texto de adjuntos que ve el extractor de memoria
METADATA_ATTACHMENT_CHARS=12000
# Ciclo de vida de /sessions: inactiva -> archivada (409) -> purgada
SESSION_IDLE_ARCHIVE_HOURS=24
SESSION_ARCHIVE_RETENTION_HOURS=72
# Extractor de memoria (vacío = LLM_MODEL)
METADATA_MODEL=
# Tiers: perfil del llamante. jwt = token del backend de negocio; off = DEFAULT_TIER fijo.
AUTH_MODE=off
DEFAULT_TIER=developer
# Secreto compartido con business_backend (HS256, mínimo 32 caracteres con AUTH_MODE=jwt)
AI_SERVICE_SECRET=
CONVERSATION_TTL_MINUTES=60
CONVERSATION_MAX_ACTIVE=1000
CONVERSATION_NEAR_LIMIT_RATIO=0.8

# Langfuse Cloud (opcional). Sin claves no se envían trazas.
# Crea un proyecto en https://cloud.langfuse.com y copia las claves del proyecto.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
